# ICFWA GlueUp Sync — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git — it is listed in .gitignore.
#
# Note: Scripts currently have credentials hardcoded.
# This file documents the values in use and serves as the
# template if scripts are refactored to read from environment variables.

# ---------------------------------------------------------------
# GlueUp API Credentials
# Source: GlueUp Admin > API Settings (or password manager)
# ---------------------------------------------------------------
GLUEUP_PUBLIC_KEY=your_public_key_here
GLUEUP_PRIVATE_KEY=your_private_key_here
GLUEUP_ORG_ID=7912
GLUEUP_API_BASE_URL=https://api-services.glueup.com/v2

# ---------------------------------------------------------------
# GlueUp Account
# ---------------------------------------------------------------
GLUEUP_EMAIL=technology@icfwashingtonstate.org
# Store the MD5 hash of the password, not the plaintext password.
# Regenerate if password changes:
#   macOS:  md5 -s 'PASSWORD'
#   Linux:  echo -n 'PASSWORD' | md5sum
GLUEUP_PASSWORD_MD5=your_md5_hash_here

# ---------------------------------------------------------------
# Google Drive Folder IDs
# ---------------------------------------------------------------
GDRIVE_SYNC_OUTPUT_FOLDER_ID=1BQ53mlYzkl3N5wz6AiTZm1kDpibempJy
# Inbound folder: Shared Drive > Data Transfer > Inbound (locate ID in Drive URL)
GDRIVE_INBOUND_FOLDER_ID=your_inbound_folder_id_here

# ---------------------------------------------------------------
# ICF Global SOAP API (Phase 1 — not yet active)
# Source: ICF Global / Megan Paulini (support@coachingfederation.org)
# ---------------------------------------------------------------
ICF_SOAP_USERNAME=
ICF_SOAP_PASSWORD=
# Endpoints:
#   TEST: https://apps.coachingfederation.org/nficftest/xweb/netForumXML.asmx
#   LIVE: https://apps.coachingfederation.org/xweb/netForumXML.asmx
ICF_SOAP_ENDPOINT=
